{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowBedrockInference",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:ap-south-1::foundation-model/google.gemma-3-12b-it",
        "arn:aws:bedrock:ap-south-1::foundation-model/google.gemma-3-4b-it",
        "arn:aws:bedrock:ap-south-1::foundation-model/*"
      ]
    }
  ]
}
