{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowBedrockInference",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:ap-south-1::foundation-model/qwen.qwen3-32b-v1:0",
        "arn:aws:bedrock:ap-south-1::foundation-model/qwen.*",
        "arn:aws:bedrock:ap-south-1::foundation-model/*"
      ]
    }
  ]
}
